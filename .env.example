# Copy this to .env for local overrides, or set VITE_BACKEND_URL in
# Vercel's Project Settings -> Environment Variables for production.
#
# Local dev default (used automatically if this var is unset): http://localhost:8080
#
# Production example, once the backend is deployed (e.g. to Render):
# VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=https://backend-render-4o11.onrender.com

# Optional: TURN server for NAT traversal when a direct/STUN-only path isn't
# reachable (symmetric NAT, restrictive firewalls). If unset, the app falls
# back to the free public Open Relay TURN server automatically — fine for
# testing, but shared/rate-limited with no uptime guarantee. Set all three
# to override it with your own provider (Metered, Twilio, Xirsys, etc.):
VITE_TURN_URL=turn:global.relay.metered.ca:80
VITE_TURN_USERNAME=83b471b6e052d1cb24f84dae
VITE_TURN_CREDENTIAL=w89L6DaSpjGJezZB
