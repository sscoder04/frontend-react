# Copy this to .env for local overrides, or set VITE_BACKEND_URL in
# Netlify's Site settings -> Environment variables for production.
#
# Local dev default (used automatically if this var is unset): http://localhost:8080
#
# Production example, once the backend is deployed (e.g. to Render):
# VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:8080
